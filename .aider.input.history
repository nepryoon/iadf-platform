+def test_validate_document_accepts_valid_evidence_receipt():
+    from iadf.schemas import validate_document
+    doc = _valid_evidence_receipt()
+    assert validate_document("evidence_receipt", doc) is None
+
+
+def test_validate_document_rejects_bad_result_enum():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    doc["result"] = "NOT_A_REAL_RESULT"
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert len(excinfo.value.errors) >= 1
+    assert any("result" in msg for msg in excinfo.value.errors)
+
+
+def test_validate_document_rejects_missing_required_field():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert len(excinfo.value.errors) >= 1
+
+
+def test_validate_document_rejects_additional_property():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    doc["unexpected_extra_field"] = "nope"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_rejects_bad_digest_pattern():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    doc["subject_digest"] = "not-a-valid-hex-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_collects_all_errors():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    doc["result"] = "BOGUS"
+    doc["subject_digest"] = "bogus"
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    # at least 2 distinct violations reported
+    assert len(excinfo.value.errors) >= 2
