+
+def test_package_version():
+    import iadf
+    assert iadf.__version__ == "0.1.0"
+
+
+# ---------------------------------------------------------------------------
+# 2. Schema files exist and are valid JSON with expected top-level shape
+# ---------------------------------------------------------------------------
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SCHEMA_DIR = REPO_ROOT / "iadf" / "schemas"
+
+RESULT_ALGEBRA_EXPECTED = (
+    "PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "ERROR",
+    "INCONCLUSIVE", "TIMEOUT", "STALE", "EXPIRED", "SUPERSEDED",
+)
+
+
+def _load_schema_file(filename):
+    path = SCHEMA_DIR / filename
+    assert path.exists(), f"missing schema file: {path}"
+    with open(path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+def test_evidence_receipt_schema_file_shape():
+    schema = _load_schema_file("evidence_receipt.schema.json")
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["$id"] == "iadf://schema/evidence-receipt/v1"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+    required = set(schema["required"])
+    expected_required = {
+        "receipt_id", "schema_id", "subject_digest", "gate_id",
+        "issuer_id", "result", "issued_at", "expires_at",
+        "policy_digest", "binding_digest", "signature",
+    }
+    assert required == expected_required
+
+    props = schema["properties"]
+    assert props["result"]["enum"] == list(RESULT_ALGEBRA_EXPECTED)
+    assert props["schema_id"]["const"] == "iadf://schema/evidence-receipt/v1"
+    assert props["subject_digest"]["pattern"] == r"^[a-f0-9]{64}$"
+    assert props["policy_digest"]["pattern"] == r"^[a-f0-9]{64}$"
+
+    sig = props["signature"]
+    assert sig["additionalProperties"] is False
+    assert set(sig["required"]) == {"alg", "key_id", "value"}
+
+
+def test_aoe_schema_file_shape():
+    schema = _load_schema_file("aoe.schema.json")
+    assert schema["$id"] == "iadf://schema/autonomous-operating-envelope/v1"
+    assert schema["additionalProperties"] is False
+    required = set(schema["required"])
+    expected_required = {
+        "envelope_id", "project_id", "version", "status",
+        "allowed_change_classes", "excluded_paths", "risk_ceiling",
+        "budgets", "data_residency", "retention_days",
+        "effective_from", "effective_to", "signature",
