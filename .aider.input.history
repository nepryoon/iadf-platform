+```python
+"""Schema loading and validation utilities for IADF."""
+
+from __future__ import annotations
+
+import functools
+import json
+from pathlib import Path
+from typing import Any
+
+import jsonschema
+
+__all__ = [
+    "RESULT_ALGEBRA",
+    "SCHEMA_DIR",
+    "SchemaValidationError",
+    "load_schema",
+    "validate_document",
+]
+
+RESULT_ALGEBRA: tuple[str, ...] = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SCHEMA_DIR: Path = Path(__file__).parent
+
+_SCHEMA_FILENAMES: dict[str, str] = {
+    "evidence_receipt": "evidence_receipt.schema.json",
+    "aoe": "aoe.schema.json",
+    "acm": "acm.schema.json",
+}
+
+
+@functools.lru_cache(maxsize=None)
+def load_schema(name: str) -> dict[str, Any]:
+    """Load a JSON schema by its logical name.
+
+    Args:
+        name: One of ``"evidence_receipt"``, ``"aoe"``, or ``"acm"``.
+
+    Returns:
+        The parsed schema dictionary.
+
+    Raises:
+        KeyError: If ``name`` is not a known schema name.
+    """
+    if name not in _SCHEMA_FILENAMES:
+        raise KeyError(f"Unknown schema name: {name!r}")
+    filename = _SCHEMA_FILENAMES[name]
+    path = SCHEMA_DIR / filename
+    with path.open("r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+class SchemaValidationError(Exception):
+    """Raised when a document fails validation against a schema."""
+
+    def __init__(self, errors: list[str]) -> None:
+        self.errors = errors
+        super().__init__("; ".join(errors))
+
+
+def validate_document(name: str, document: dict[str, Any]) -> None:
+    """Validate ``document`` against the schema named ``name``.
+
+    Args:
+        name: Logical schema name (see :func:`load_schema`).
+        document: The JSON document to validate.
+
+    Raises:
+        SchemaValidationError: If validation fails.
+    """
+    schema = load_schema(name)
+    validator = jsonschema.Draft202012Validator(
+        schema,
+        format_checker=jsonschema.FormatChecker(),
+    )
+    errors: list[str] = []
+    for error in validator.iter_errors(document):
+        path = "/".join(str(p) for p in error.absolute_path) or "<root>"
+        errors.append(f"{path}: {error.message}")
+    if errors:
+        raise SchemaValidationError(errors)
+```
+
