+```python
+
+"""
+Red-proof tests for TASK-01-SCHEMAS.
+
+These tests MUST fail on the current codebase (stub implementation) and
+MUST pass once the production code faithfully implements the specification.
+"""
+import json
+import re
+import uuid
+from pathlib import Path
+
+import pytest
+
+import iadf
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    load_schema,
+    validate_document,
+    SchemaValidationError,
+)
+
+HEX64 = "a" * 64
+UUID1 = str(uuid.uuid4())
+UUID2 = str(uuid.uuid4())
+UUID3 = str(uuid.uuid4())
+UUID4 = str(uuid.uuid4())
+
+
+# ---------------------------------------------------------------------------
+# Package marker
+# ---------------------------------------------------------------------------
+
+def test_package_version():
+    assert iadf.__version__ == "0.1.0"
+
+
+# ---------------------------------------------------------------------------
+# RESULT_ALGEBRA — single source of truth
+# ---------------------------------------------------------------------------
+
+def test_result_algebra_exact_order():
+    assert RESULT_ALGEBRA == (
+        "PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "ERROR",
+        "INCONCLUSIVE", "TIMEOUT", "STALE", "EXPIRED", "SUPERSEDED",
+    )
+    assert len(RESULT_ALGEBRA) == 11
+
+
+def test_schema_dir_is_path_and_exists():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name,expected_id", [
+    ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+    ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+    ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+])
+def test_load_schema_valid_names(name, expected_id):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$id"] == expected_id
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_is_cached_same_object():
+    s1 = load_schema("aoe")
+    s2 = load_schema("aoe")
+    assert s1 == s2
+
+
+# ---------------------------------------------------------------------------
+# EvidenceReceipt schema content checks (raw JSON file inspection)
+# ---------------------------------------------------------------------------
+
+def test_evidence_receipt_schema_file_raw_content():
+    path = SCHEMA_DIR / "evidence_receipt.schema.json"
+    assert path.exists()
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/evidence-receipt/v1"
+    props = data["properties"]
+    assert props["schema_id"]["const"] == "iadf://schema/evidence-receipt/v1"
+    assert props["result"]["enum"] == list(RESULT_ALGEBRA)
+    assert props["subject_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    assert props["policy_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    required = set(data["required"])
+    expected_required = {
+        "receipt_id", "schema_id", "subject_digest", "gate_id", "issuer_id",
+        "result", "issued_at", "expires_at", "policy_digest",
+        "binding_digest", "signature",
+    }
+    assert expected_required <= required
+    sig = props["signature"]
+    assert sig["additionalProperties"] is False
+    assert set(sig["required"]) == {"alg", "key_id", "value"}
+
+
+def _valid_evidence_receipt():
+    return {
+        "receipt_id": UUID1,
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": HEX64,
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": HEX64,
+        "binding_digest": None,
+        "signature": {"alg": "ed25519", "key_id": "k1", "value": "sig"},
+    }
+
+
+def test_evidence_receipt_valid_document_passes():
+    doc = _valid_evidence_receipt()
+    validate_document("evidence_receipt", doc)  # must not raise
+
+
+def test_evidence_receipt_rejects_bad_result_enum():
+    doc = _valid_evidence_receipt()
+    doc["result"] = "NOT_A_REAL_RESULT"
+    with pytest.raises(SchemaValidationError) as exc:
+        validate_document("evidence_receipt", doc)
+    assert len(exc.value.errors) >= 1
+    assert all(isinstance(e, str) for e in exc.value.errors)
+
+
+def test_evidence_receipt_rejects_bad_digest_pattern():
+    doc = _valid_evidence_receipt()
+    doc["subject_digest"] = "not-a-hex-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_rejects_additional_properties():
+    doc = _valid_evidence_receipt()
+    doc["unexpected_field"] = "surprise"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_rejects_wrong_schema_id_const():
+    doc = _valid_evidence_receipt()
+    doc["schema_id"] = "iadf://schema/something-else/v1"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_multiple_violations_multiple_errors():
+    doc = _valid_evidence_receipt()
+    doc["result"] = "BOGUS"
+    doc["subject_digest"] = "bad"
+    doc["policy_digest"] = "also-bad"
+    with pytest.raises(SchemaValidationError) as exc:
+        validate_document("evidence_receipt", doc)
+    assert len(exc.value.errors) >= 3
+
+
+# ---------------------------------------------------------------------------
+# AOE schema content checks
+# ---------------------------------------------------------------------------
+
+def test_aoe_schema_file_raw_content():
+    path = SCHEMA_DIR / "aoe.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/autonomous-operating-envelope/v1"
+    props = data["properties"]
+    assert props["status"]["enum"] == ["DRAFT", "ACTIVE", "EXPIRED", "SUPERSEDED"]
+    assert props["risk_ceiling"]["enum"] == ["R0", "R1", "R2", "R3"]
+    assert props["data_residency"]["const"] == "eu-only"
+    assert props["retention_days"]["minimum"] == 1
+    assert props["retention_days"]["maximum"] == 2555
+    budgets = props["budgets"]
+    assert budgets["additionalProperties"] is False
+    assert set(budgets["required"]) == {
+        "max_cost_eur", "max_tokens_per_call", "max_wall_seconds",
+    }
+    assert budgets["properties"]["max_cost_eur"]["exclusiveMinimum"] == 0
+    assert budgets["properties"]["max_tokens_per_call"]["exclusiveMinimum"] == 0
+    assert budgets["properties"]["max_wall_seconds"]["exclusiveMinimum"] == 0
+
+
+def _valid_aoe():
+    return {
+        "envelope_id": UUID1,
+        "project_id": UUID2,
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor", "bugfix"],
+        "excluded_paths": ["secrets/"],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 4096,
+            "max_wall_seconds": 300,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2025-01-01T00:00:00Z",
+        "signature": {"alg": "ed25519", "key_id": "k1", "value": "sig"},
+    }
