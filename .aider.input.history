+        "LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU",
+    ]
+    rollback = props["rollback_contract"]
+    assert rollback["additionalProperties"] is False
+    assert rollback["properties"]["type"]["enum"] == [
+        "redeploy_previous_digest", "expand_contract_migration",
+    ]
+    csp_items = props["change_set_plan"]["items"]
+    assert csp_items["additionalProperties"] is False
+    assert set(csp_items["required"]) == {"changeset_id", "path_globs", "depends_on"}
