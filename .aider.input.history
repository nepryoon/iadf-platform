+# ---------------------------------------------------------------------------
+# Package marker
+# ---------------------------------------------------------------------------
+
+def test_iadf_package_version():
+    assert iadf.__version__ == "0.1.0"
+
+
+# ---------------------------------------------------------------------------
+# RESULT_ALGEBRA — exact order (ADD §20.2)
+# ---------------------------------------------------------------------------
+
+def test_result_algebra_exact_order():
+    assert RESULT_ALGEBRA == (
+        "PASS",
+        "FAIL",
+        "NOT_RUN",
+        "SKIPPED",
+        "UNKNOWN",
+        "ERROR",
+        "INCONCLUSIVE",
+        "TIMEOUT",
+        "STALE",
+        "EXPIRED",
+        "SUPERSEDED",
+    )
+    assert len(RESULT_ALGEBRA) == 11
+
+
+# ---------------------------------------------------------------------------
+# SCHEMA_DIR
+# ---------------------------------------------------------------------------
+
+def test_schema_dir_points_to_existing_directory_with_schema_files():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+    assert (SCHEMA_DIR / "evidence_receipt.schema.json").is_file()
+    assert (SCHEMA_DIR / "aoe.schema.json").is_file()
+    assert (SCHEMA_DIR / "acm.schema.json").is_file()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "name,expected_id",
+    [
+        ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+        ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_load_schema_returns_correct_schema(name, expected_id):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$id"] == expected_id
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_is_cached_same_object():
+    s1 = load_schema("aoe")
+    s2 = load_schema("aoe")
+    assert s1 is s2
+
+
+# ---------------------------------------------------------------------------
+# Raw JSON file structural checks (read as text/json — no network)
+# ---------------------------------------------------------------------------
+
+def test_evidence_receipt_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "evidence_receipt.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/evidence-receipt/v1"
+    required = set(data["required"])
+    assert required == {
+        "receipt_id",
+        "schema_id",
+        "subject_digest",
+        "gate_id",
+        "issuer_id",
+        "result",
+        "issued_at",
+        "expires_at",
+        "policy_digest",
+        "binding_digest",
+        "signature",
+    }
+    result_enum = data["properties"]["result"]["enum"]
+    assert result_enum == [
+        "PASS",
+        "FAIL",
+        "NOT_RUN",
+        "SKIPPED",
+        "UNKNOWN",
+        "ERROR",
+        "INCONCLUSIVE",
+        "TIMEOUT",
+        "STALE",
+        "EXPIRED",
+        "SUPERSEDED",
+    ]
+    assert data["properties"]["subject_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    sig_props = data["properties"]["signature"]
+    assert sig_props["additionalProperties"] is False
+    assert set(sig_props["required"]) == {"alg", "key_id", "value"}
+
+
+def test_aoe_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "aoe.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/autonomous-operating-envelope/v1"
+    assert data["properties"]["data_residency"]["const"] == "eu-only"
+    assert data["properties"]["risk_ceiling"]["enum"] == ["R0", "R1", "R2", "R3"]
+    assert data["properties"]["status"]["enum"] == [
+        "DRAFT",
+        "ACTIVE",
+        "EXPIRED",
+        "SUPERSEDED",
+    ]
+    budgets = data["properties"]["budgets"]
+    assert budgets["additionalProperties"] is False
+    assert set(budgets["required"]) == {
+        "max_cost_eur",
+        "max_tokens_per_call",
+        "max_wall_seconds",
+    }
+    assert (
+        data["properties"]["retention_days"]["maximum"] == 2555
+    )
+
+
+def test_acm_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "acm.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/autonomous-change-manifest/v1"
+    assert data["properties"]["status"]["enum"] == [
+        "DRAFT",
+        "ACTIVATED",
+        "REJECTED",
