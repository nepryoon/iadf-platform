+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_SAMPLE = "a" * 64
+SIGNATURE = {"alg": "ed25519", "key_id": "k1", "value": "abc123"}
+
+
+def _valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": SHA256_SAMPLE,
+        "gate_id": "gate.security.sast",
+        "issuer_id": "controller-01",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": SHA256_SAMPLE,
+        "binding_digest": None,
+        "signature": SIGNATURE,
+    }
+
+
+def _valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor", "bugfix"],
+        "excluded_paths": ["/secrets/**"],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 4096,
+            "max_wall_seconds": 600,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2024-06-01T00:00:00Z",
+        "signature": SIGNATURE,
+    }
+
+
+def _valid_acm():
+    return {
