+```python
+import functools
+import json
+from pathlib import Path
+
+import jsonschema
+
+RESULT_ALGEBRA: tuple[str, ...] = (
+    "PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "ERROR",
+    "INCONCLUSIVE", "TIMEOUT", "STALE", "EXPIRED", "SUPERSEDED",
+)
+
+SCHEMA_DIR: Path = Path(__file__).parent
+
+_SCHEMA_FILES: dict[str, str] = {
+    "evidence_receipt": "evidence_receipt.schema.json",
+    "aoe": "aoe.schema.json",
+    "acm": "acm.schema.json",
+}
+
+FORMAT_CHECKER = jsonschema.FormatChecker()
+
+
+class SchemaValidationError(Exception):
+    def __init__(self, errors: list[str]) -> None:
+        self.errors = list(errors)
+        super().__init__("\n".join(self.errors))
+
+
+@functools.lru_cache(maxsize=None)
+def load_schema(name: str) -> dict:
+    try:
+        filename = _SCHEMA_FILES[name]
+    except KeyError as exc:
+        raise KeyError(f"unknown schema name: {name!r}") from exc
+    return json.loads((SCHEMA_DIR / filename).read_text(encoding="utf-8"))
+
+
+def validate_document(name: str, document: dict) -> None:
+    validator = jsonschema.Draft202012Validator(
+        load_schema(name), format_checker=FORMAT_CHECKER
+    )
+    messages = [
+        f"{getattr(err, 'json_path', None) or str(list(err.path))}: {err.message}"
+        for err in sorted(validator.iter_errors(document), key=lambda e: list(e.path))
+    ]
+    if messages:
+        raise SchemaValidationError(messages)
