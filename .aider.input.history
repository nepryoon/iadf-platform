+        "backlog_item_id": str(uuid.uuid4()),
+        "envelope_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": "c" * 64,
+        "policy_digest": "d" * 64,
+        "budget_digest": "e" * 64,
+        "data_class": "INT",
+        "risk_class": "R1",
+        "change_set_plan": [
