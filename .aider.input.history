+        "UNKNOWN",
+        "ERROR",
+        "INCONCLUSIVE",
+        "TIMEOUT",
+        "STALE",
+        "EXPIRED",
+        "SUPERSEDED",
+    )
+    assert len(RESULT_ALGEBRA) == 11
+
+
+# ---------------------------------------------------------------------------
+# SCHEMA_DIR
+# ---------------------------------------------------------------------------
+
+def test_schema_dir_points_to_existing_directory_with_schema_files():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+    assert (SCHEMA_DIR / "evidence_receipt.schema.json").is_file()
+    assert (SCHEMA_DIR / "aoe.schema.json").is_file()
+    assert (SCHEMA_DIR / "acm.schema.json").is_file()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "name,expected_id",
+    [
+        ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+        ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_load_schema_returns_correct_schema(name, expected_id):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$id"] == expected_id
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_is_cached_same_object():
+    s1 = load_schema("aoe")
+    s2 = load_schema("aoe")
+    assert s1 is s2
+
+
+# ---------------------------------------------------------------------------
+# Raw JSON file structural checks (read as text/json — no network)
+# ---------------------------------------------------------------------------
+
+def test_evidence_receipt_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "evidence_receipt.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/evidence-receipt/v1"
+    required = set(data["required"])
+    assert required == {
+        "receipt_id",
+        "schema_id",
+        "subject_digest",
+        "gate_id",
+        "issuer_id",
+        "result",
+        "issued_at",
+        "expires_at",
+        "policy_digest",
+        "binding_digest",
+        "signature",
+    }
+    result_enum = data["properties"]["result"]["enum"]
+    assert result_enum == [
+        "PASS",
+        "FAIL",
+        "NOT_RUN",
+        "SKIPPED",
+        "UNKNOWN",
+        "ERROR",
+        "INCONCLUSIVE",
+        "TIMEOUT",
+        "STALE",
+        "EXPIRED",
+        "SUPERSEDED",
+    ]
+    assert data["properties"]["subject_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    sig_props = data["properties"]["signature"]
+    assert sig_props["additionalProperties"] is False
+    assert set(sig_props["required"]) == {"alg", "key_id", "value"}
+
+
+def test_aoe_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "aoe.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/autonomous-operating-envelope/v1"
+    assert data["properties"]["data_residency"]["const"] == "eu-only"
+    assert data["properties"]["risk_ceiling"]["enum"] == ["R0", "R1", "R2", "R3"]
+    assert data["properties"]["status"]["enum"] == [
+        "DRAFT",
+        "ACTIVE",
+        "EXPIRED",
+        "SUPERSEDED",
+    ]
+    budgets = data["properties"]["budgets"]
+    assert budgets["additionalProperties"] is False
+    assert set(budgets["required"]) == {
+        "max_cost_eur",
+        "max_tokens_per_call",
+        "max_wall_seconds",
+    }
+    assert (
+        data["properties"]["retention_days"]["maximum"] == 2555
+    )
+
+
+def test_acm_schema_file_contents():
+    path = REPO_ROOT / "iadf" / "schemas" / "acm.schema.json"
+    data = json.loads(path.read_text())
+    assert data["$id"] == "iadf://schema/autonomous-change-manifest/v1"
+    assert data["properties"]["status"]["enum"] == [
+        "DRAFT",
+        "ACTIVATED",
+        "REJECTED",
+    ]
+    assert data["properties"]["data_class"]["enum"] == [
+        "PUB",
+        "INT",
+        "CONF",
+        "SRC",
+        "SEC",
+    ]
+    assert data["properties"]["risk_class"]["enum"] == ["R0", "R1", "R2", "R3"]
+    csp_items = data["properties"]["change_set_plan"]["items"]
+    assert csp_items["additionalProperties"] is False
+    assert set(csp_items["required"]) == {
+        "changeset_id",
+        "path_globs",
+        "depends_on",
+    }
+    rc = data["properties"]["rollback_contract"]
+    assert rc["additionalProperties"] is False
+    assert set(rc["required"]) == {"type", "target"}
+    assert rc["properties"]["type"]["enum"] == [
+        "redeploy_previous_digest",
+        "expand_contract_migration",
+    ]
+    envs = data["properties"]["environments"]["items"]["enum"]
+    assert envs == ["LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU"]
+
+
+# ---------------------------------------------------------------------------
+# validate_document — happy paths
+# ---------------------------------------------------------------------------
+
+def test_validate_document_accepts_valid_evidence_receipt():
+    assert validate_document("evidence_receipt", valid_evidence_receipt()) is None
+
+
+def test_validate_document_accepts_valid_aoe():
+    assert validate_document("aoe", valid_aoe()) is None
+
+
+def test_validate_document_accepts_valid_acm():
+    assert validate_document("acm", valid_acm()) is None
+
+
+# ---------------------------------------------------------------------------
+# validate_document — failure paths / error semantics
+# ---------------------------------------------------------------------------
+
+def test_validate_document_rejects_missing_required_field():
+    doc = valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    assert len(exc_info.value.errors) >= 1
+    assert any("gate_id" in e for e in exc_info.value.errors)
+
+
+def test_validate_document_rejects_invalid_result_enum_value():
+    doc = valid_evidence_receipt()
+    doc["result"] = "NOT_A_REAL_RESULT"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_rejects_bad_digest_pattern():
+    doc = valid_evidence_receipt()
+    doc["subject_digest"] = "not-a-valid-hex-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_rejects_additional_properties():
+    doc = valid_aoe()
+    doc["unexpected_extra_field"] = "nope"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_document_collects_multiple_errors():
+    doc = valid_acm()
+    del doc["manifest_id"]
+    doc["status"] = "NOT_A_STATUS"
+    doc["risk_class"] = "R9"
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("acm", doc)
+    assert len(exc_info.value.errors) >= 3
+
+
+def test_validate_document_rejects_empty_change_set_plan():
+    doc = valid_acm()
+    doc["change_set_plan"] = []
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_document_rejects_negative_budget_values():
+    doc = valid_aoe()
+    doc["budgets"]["max_cost_eur"] = -5
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_document_rejects_unknown_schema_name():
+    with pytest.raises(KeyError):
+        validate_document("not_a_schema", {})
+```

# 2026-08-18 22:28:57.111564
+[IADF TASK-01-SCHEMAS] Contract-first JSON Schemas: AOE, ACM, EvidenceReceipt (ADD §4, §19, §20.2, §25.5)
+
+Implementa esattamente i seguenti file (nessun altro file di produzione),
+seguendo fedelmente la specifica fornita in `specification_markdown`:
+
+1. `iadf/__init__.py` — deve esporre `__version__ = "0.1.0"`.
+
+2. `iadf/schemas/evidence_receipt.schema.json` — JSON Schema Draft 2020-12
+   per EvidenceReceipt, con tutti i campi, required, enum `result` (11
+   valori, ordine esatto), pattern sha256, oggetto `signature`.
+
+3. `iadf/schemas/aoe.schema.json` — JSON Schema Draft 2020-12 per
+   AutonomousOperatingEnvelope, con tutti i campi indicati (status, budgets,
+   risk_ceiling, data_residency const "eu-only", retention_days max 2555,
+   signature, ecc.).
+
+4. `iadf/schemas/acm.schema.json` — JSON Schema Draft 2020-12 per
+   AutonomousChangeManifest, con status, data_class, risk_class,
+   change_set_plan (array di oggetti con changeset_id/path_globs/
+   depends_on), rollback_contract, environments enum, ecc.
+
+5. `iadf/schemas/__init__.py` — modulo Python con:
+   - `RESULT_ALGEBRA`: tuple dei 11 valori nell'ordine esatto specificato;
+   - `SCHEMA_DIR`: `Path` verso la directory `iadf/schemas`;
+   - `load_schema(name: str) -> dict`: carica e parsea il file JSON
+     corrispondente a "evidence_receipt" | "aoe" | "acm", con caching via
+     `functools.lru_cache`; solleva `KeyError` per nomi non riconosciuti;
+   - `class SchemaValidationError(Exception)`: espone attributo `.errors`
+     (lista di stringhe leggibili, con JSON path);
+   - `validate_document(name: str, document: dict) -> None`: usa
+     `jsonschema.Draft202012Validator` con `format_checker` abilitato,
+     raccoglie TUTTI gli errori di validazione (non solo il primo) e
+     solleva `SchemaValidationError` se presenti, altrimenti ritorna None.
+     Se `name` non è riconosciuto, deve propagare `KeyError` (da
+     `load_schema`).
+
+Vincoli:
+- Non modificare/creare altri file oltre a quelli elencati in
+  `target_files`.
+- Non modificare il file di test fornito.
+- Usa solo la libreria standard, `jsonschema` e `pydantic` (quest'ultima
+  non è strettamente necessaria per questo task ma è permessa) come
+  dipendenze esterne.
+- I JSON Schema devono avere `"$schema"` impostato al draft 2020-12 URI,
+  `"$id"` esatto come specificato, `"type": "object"` e
+  `"additionalProperties": false` a livello radice (e nei sotto-oggetti
+  indicati: `signature`, `budgets`, `rollback_contract`, item di
+  `change_set_plan`).
+- L'enum `result` in evidence_receipt.schema.json deve avere esattamente
+  questi 11 valori in questo ordine: PASS, FAIL, NOT_RUN, SKIPPED,
+  UNKNOWN, ERROR, INCONCLUSIVE, TIMEOUT, STALE, EXPIRED, SUPERSEDED.
+
+Criterio di accettazione: eseguire `pytest tests/test_task01_schemas.py`
+e farlo passare integralmente SENZA modificare il file di test.
