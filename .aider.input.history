+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
+
+
+def make_digest(seed: str) -> str:
