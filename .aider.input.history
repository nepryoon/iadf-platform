+
+def test_acm_rejects_bad_environment_enum():
+    doc = _valid_acm()
+    doc["environments"] = ["MARS-EU"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_acm_rejects_empty_change_set_plan():
