+from __future__ import annotations
+
+import json
+from functools import lru_cache
+from pathlib import Path
+from typing import Any, Dict, List
+
+import jsonschema
+
+RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SCHEMA_DIR = Path(__file__).resolve().parent
+
+_SCHEMA_FILES = {
+    "evidence_receipt": "evidence_receipt.schema.json",
+    "aoe": "aoe.schema.json",
+    "acm": "acm.schema.json",
+}
+
+
+@lru_cache(maxsize=None)
+def load_schema(name: str) -> Dict[str, Any]:
+    """Load and parse the JSON schema for the given name."""
+    if name not in _SCHEMA_FILES:
+        raise KeyError(f"Unknown schema name: {name}")
+    path = SCHEMA_DIR / _SCHEMA_FILES[name]
+    with path.open("r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+class SchemaValidationError(Exception):
+    """Raised when a document fails validation against a schema."""
+
+    def __init__(self, errors: List[str]):
+        super().__init__("; ".join(errors))
+        self.errors = errors
+
+
+def validate_document(name: str, document: dict) -> None:
+    """Validate a document against the named schema.
+
+    Raises SchemaValidationError if any validation errors occur.
+    """
+    schema = load_schema(name)
+    validator = jsonschema.Draft202012Validator(
+        schema,
+        format_checker=jsonschema.FormatChecker(),
+    )
+    errors = list(validator.iter_errors(document))
+    if errors:
+        messages = []
+        for error in errors:
+            # Build a readable JSON path
+            path = list(error.absolute_path)
+            if path:
+                path_str = "/" + "/".join(str(p) for p in path)
+            else:
+                path_str = "/"
+            messages.append(f"{path_str}: {error.message}")
+        raise SchemaValidationError(messages)
+```
