+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "service-x",
+        },
+        "environments": ["DEV-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+def test_acm_valid_document_passes():
+    validate_document("acm", _valid_acm())
+
+
+def test_acm_rejects_bad_status_enum():
