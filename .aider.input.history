+        "project_id": _uuid(),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor", "feature"],
+        "excluded_paths": ["secrets/**"],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 4096,
+            "max_wall_seconds": 3600,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": _now_iso(),
+        "effective_to": _now_iso(offset_seconds=3600),
+        "signature": valid_signature(),
+    }
+
+
+def valid_acm():
+    changeset_id = _uuid()
+    return {
