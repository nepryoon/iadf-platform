+import json
+import re
+import uuid
+from pathlib import Path
+
+import pytest
+
+# --- Import production modules at their authoritative paths -------------
+import iadf
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    load_schema,
+    validate_document,
+    SchemaValidationError,
+)
+
+
+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
+
+
+def make_sig():
+    return {"alg": "ed25519", "key_id": "k1", "value": "abc123"}
+
+
+def valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": "a" * 64,
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": "b" * 64,
+        "binding_digest": None,
+        "signature": make_sig(),
+    }
+
+
+def valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor"],
+        "excluded_paths": [],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 1000,
+            "max_wall_seconds": 60,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2025-01-01T00:00:00Z",
+        "signature": make_sig(),
+    }
+
+
+def valid_acm():
+    cs_id = str(uuid.uuid4())
+    return {
+        "manifest_id": str(uuid.uuid4()),
+        "backlog_item_id": str(uuid.uuid4()),
+        "envelope_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": "c" * 64,
+        "policy_digest": "d" * 64,
+        "budget_digest": "e" * 64,
+        "data_class": "INT",
+        "risk_class": "R1",
+        "change_set_plan": [
+            {
+                "changeset_id": cs_id,
+                "path_globs": ["src/**/*.py"],
+                "depends_on": [],
+            }
+        ],
+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "prev-digest-ref",
+        },
+        "environments": ["DEV-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+# --------------------------------------------------------------------------
+# Package basics
+# --------------------------------------------------------------------------
+
+def test_package_version():
+    assert iadf.__version__ == "0.1.0"
+
+
+def test_result_algebra_exact_order():
+    assert RESULT_ALGEBRA == EXPECTED_RESULT_ALGEBRA
+    assert isinstance(RESULT_ALGEBRA, tuple)
+
+
+def test_schema_dir_exists_and_is_path():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+    assert (SCHEMA_DIR / "evidence_receipt.schema.json").is_file()
+    assert (SCHEMA_DIR / "aoe.schema.json").is_file()
+    assert (SCHEMA_DIR / "acm.schema.json").is_file()
+
+
+# --------------------------------------------------------------------------
+# load_schema
+# --------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name", ["evidence_receipt", "aoe", "acm"])
+def test_load_schema_returns_dict(name):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_is_cached_same_object_or_equal():
+    a = load_schema("aoe")
+    b = load_schema("aoe")
+    assert a == b
+
+
+# --------------------------------------------------------------------------
+# Raw JSON structural assertions (normative literals)
+# --------------------------------------------------------------------------
+
+def test_evidence_receipt_schema_ids_and_result_enum():
+    schema = load_schema("evidence_receipt")
+    assert schema["$id"] == "iadf://schema/evidence-receipt/v1"
+    props = schema["properties"]
+    assert props["schema_id"]["const"] == "iadf://schema/evidence-receipt/v1"
+    result_enum = props["result"]["enum"]
+    assert list(result_enum) == list(EXPECTED_RESULT_ALGEBRA)
+    assert props["subject_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    assert props["policy_digest"]["pattern"] == "^[a-f0-9]{64}$"
+    required = set(schema["required"])
+    expected_required = {
+        "receipt_id", "schema_id", "subject_digest", "gate_id",
+        "issuer_id", "result", "issued_at", "expires_at",
+        "policy_digest", "binding_digest", "signature",
+    }
+    assert required == expected_required
+    sig_schema = props["signature"]
+    assert sig_schema["additionalProperties"] is False
+    assert set(sig_schema["required"]) == {"alg", "key_id", "value"}
+
+
+def test_aoe_schema_ids_and_fields():
+    schema = load_schema("aoe")
+    assert schema["$id"] == "iadf://schema/autonomous-operating-envelope/v1"
+    props = schema["properties"]
+    assert props["status"]["enum"] == ["DRAFT", "ACTIVE", "EXPIRED", "SUPERSEDED"]
+    assert props["risk_ceiling"]["enum"] == ["R0", "R1", "R2", "R3"]
+    assert props["data_residency"]["const"] == "eu-only"
+    assert props["retention_days"]["minimum"] == 1
+    assert props["retention_days"]["maximum"] == 2555
+    budgets = props["budgets"]
+    assert budgets["additionalProperties"] is False
+    assert set(budgets["required"]) == {
+        "max_cost_eur", "max_tokens_per_call", "max_wall_seconds",
+    }
+    assert budgets["properties"]["max_cost_eur"]["exclusiveMinimum"] == 0
+    assert schema["additionalProperties"] is False
+
+
+def test_acm_schema_ids_and_fields():
+    schema = load_schema("acm")
+    assert schema["$id"] == "iadf://schema/autonomous-change-manifest/v1"
+    props = schema["properties"]
+    assert props["status"]["enum"] == ["DRAFT", "ACTIVATED", "REJECTED"]
+    assert props["data_class"]["enum"] == ["PUB", "INT", "CONF", "SRC", "SEC"]
+    assert props["risk_class"]["enum"] == ["R0", "R1", "R2", "R3"]
+    envs = props["environments"]
+    assert envs["items"]["enum"] == ["LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU"]
+    assert envs["minItems"] == 1
+    assert envs["uniqueItems"] is True
+    csp = props["change_set_plan"]
+    assert csp["minItems"] == 1
+    item_schema = csp["items"]
+    assert item_schema["additionalProperties"] is False
+    assert set(item_schema["required"]) == {"changeset_id", "path_globs", "depends_on"}
+    rc = props["rollback_contract"]
+    assert rc["additionalProperties"] is False
+    assert set(rc["required"]) == {"type", "target"}
+    assert rc["properties"]["type"]["enum"] == [
+        "redeploy_previous_digest", "expand_contract_migration",
+    ]
+
+
+# --------------------------------------------------------------------------
+# validate_document — happy paths
+# --------------------------------------------------------------------------
+
+def test_validate_document_evidence_receipt_valid():
+    assert validate_document("evidence_receipt", valid_evidence_receipt()) is None
+
+
+def test_validate_document_aoe_valid():
+    assert validate_document("aoe", valid_aoe()) is None
+
+
+def test_validate_document_acm_valid():
+    assert validate_document("acm", valid_acm()) is None
+
+
+@pytest.mark.parametrize("result_value", EXPECTED_RESULT_ALGEBRA)
+def test_validate_document_all_result_values_accepted(result_value):
+    doc = valid_evidence_receipt()
+    doc["result"] = result_value
+    assert validate_document("evidence_receipt", doc) is None
+
+
+# --------------------------------------------------------------------------
+# validate_document — failure paths
+# --------------------------------------------------------------------------
+
+def test_validate_document_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        validate_document("nope", {})
+
+
+def test_validate_document_invalid_result_enum_raises():
+    doc = valid_evidence_receipt()
+    doc["result"] = "NOT_A_VALID_RESULT"
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    err = exc_info.value
+    assert isinstance(err.errors, list)
+    assert len(err.errors) >= 1
+    assert any("result" in e for e in err.errors)
+
+
+def test_validate_document_missing_required_field_raises():
+    doc = valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    assert any("gate_id" in e for e in exc_info.value.errors)
+
+
+def test_validate_document_additional_property_rejected():
+    doc = valid_evidence_receipt()
+    doc["not_allowed_field"] = "x"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_bad_digest_pattern_rejected():
+    doc = valid_evidence_receipt()
+    doc["subject_digest"] = "NOT-HEX"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_document_bad_uuid_format_rejected():
+    doc = valid_aoe()
+    doc["envelope_id"] = "not-a-uuid"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_document_collects_multiple_errors():
+    doc = valid_acm()
+    doc["status"] = "BOGUS"
+    del doc["risk_class"]
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("acm", doc)
+    assert len(exc_info.value.errors) >= 2
+
+
+def test_validate_document_acm_data_class_enum_enforced():
+    doc = valid_acm()
+    doc["data_class"] = "TOP_SECRET"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_document_budgets_exclusive_minimum_enforced():
+    doc = valid_aoe()
+    doc["budgets"]["max_cost_eur"] = 0
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_document_environments_unique_items_enforced():
+    doc = valid_acm()
+    doc["environments"] = ["DEV-EU", "DEV-EU"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+# --------------------------------------------------------------------------
+# Raw file sanity (read as text, no live validation infra)
+# --------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "filename,expected_id",
+    [
+        ("evidence_receipt.schema.json", "iadf://schema/evidence-receipt/v1"),
+        ("aoe.schema.json", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm.schema.json", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_schema_files_are_valid_json_with_expected_id(filename, expected_id):
+    path = SCHEMA_DIR / filename
+    text = path.read_text(encoding="utf-8")
+    data = json.loads(text)
+    assert data["$id"] == expected_id
+    assert data["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+```
