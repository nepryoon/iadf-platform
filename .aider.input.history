+"""
+Red-proof tests for TASK-01-SCHEMAS.
+
+These tests MUST fail on the current (empty) codebase because the
+production modules/files under `iadf/` do not exist yet.
+"""
+import json
+import uuid
+import copy
+from pathlib import Path
+
+import pytest
+
+
+# ---------------------------------------------------------------------------
+# Helpers to build minimal valid documents
+# ---------------------------------------------------------------------------
+
+VALID_DIGEST = "a" * 64
+
+
+def _signature():
+    return {"alg": "ed25519", "key_id": "key-1", "value": "sigvalue"}
+
+
+def _valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": VALID_DIGEST,
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": VALID_DIGEST,
+        "binding_digest": None,
+        "signature": _signature(),
+    }
+
+
+def _valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor"],
+        "excluded_paths": [],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.0,
+            "max_tokens_per_call": 1000,
+            "max_wall_seconds": 60,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2025-01-01T00:00:00Z",
+        "signature": _signature(),
+    }
+
+
+def _valid_acm():
+    return {
+        "manifest_id": str(uuid.uuid4()),
+        "backlog_item_id": str(uuid.uuid4()),
+        "envelope_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": VALID_DIGEST,
+        "policy_digest": VALID_DIGEST,
+        "budget_digest": VALID_DIGEST,
+        "data_class": "INT",
+        "risk_class": "R1",
+        "change_set_plan": [
+            {
+                "changeset_id": str(uuid.uuid4()),
+                "path_globs": ["src/**"],
+                "depends_on": [],
+            }
+        ],
+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "prod-eu",
+        },
+        "environments": ["DEV-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Package basics
+# ---------------------------------------------------------------------------
+
+def test_package_version():
+    import iadf
+    assert iadf.__version__ == "0.1.0"
+
+
+def test_result_algebra_exact_order():
+    from iadf.schemas import RESULT_ALGEBRA
+    assert RESULT_ALGEBRA == (
+        "PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "ERROR",
+        "INCONCLUSIVE", "TIMEOUT", "STALE", "EXPIRED", "SUPERSEDED",
+    )
+
+
+def test_schema_dir_exists_and_is_path():
+    from iadf.schemas import SCHEMA_DIR
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+
+
+# ---------------------------------------------------------------------------
+# Raw schema file structural checks (read as text/json - no live validation)
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "filename,expected_id",
+    [
+        ("evidence_receipt.schema.json", "iadf://schema/evidence-receipt/v1"),
+        ("aoe.schema.json", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm.schema.json", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_schema_file_structure(filename, expected_id):
+    from iadf.schemas import SCHEMA_DIR
+    path = SCHEMA_DIR / filename
+    assert path.is_file(), f"missing schema file {filename}"
+    data = json.loads(path.read_text(encoding="utf-8"))
+    assert data["$id"] == expected_id
+    assert data["type"] == "object"
+    assert data["additionalProperties"] is False
+    assert data["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+
+
+def test_evidence_receipt_result_enum_exact():
+    from iadf.schemas import SCHEMA_DIR
+    path = SCHEMA_DIR / "evidence_receipt.schema.json"
+    data = json.loads(path.read_text(encoding="utf-8"))
+    result_prop = data["properties"]["result"]
+    assert result_prop["enum"] == [
+        "PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "ERROR",
+        "INCONCLUSIVE", "TIMEOUT", "STALE", "EXPIRED", "SUPERSEDED",
+    ]
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name", ["evidence_receipt", "aoe", "acm"])
+def test_load_schema_returns_dict(name):
+    from iadf.schemas import load_schema
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert "$id" in schema
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    from iadf.schemas import load_schema
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_is_cached_same_object():
+    from iadf.schemas import load_schema
+    s1 = load_schema("aoe")
+    s2 = load_schema("aoe")
+    assert s1 == s2
+
+
+# ---------------------------------------------------------------------------
+# validate_document - happy paths
+# ---------------------------------------------------------------------------
+
+def test_validate_document_valid_evidence_receipt():
+    from iadf.schemas import validate_document
+    validate_document("evidence_receipt", _valid_evidence_receipt())
+
+
+def test_validate_document_valid_aoe():
+    from iadf.schemas import validate_document
+    validate_document("aoe", _valid_aoe())
+
+
+def test_validate_document_valid_acm():
+    from iadf.schemas import validate_document
+    validate_document("acm", _valid_acm())
+
+
+# ---------------------------------------------------------------------------
+# validate_document - error paths
+# ---------------------------------------------------------------------------
+
+def test_validate_document_missing_required_field_raises():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert len(excinfo.value.errors) >= 1
+    assert all(isinstance(e, str) for e in excinfo.value.errors)
+
+
+def test_validate_document_invalid_result_enum_raises():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_evidence_receipt()
+    doc["result"] = "NOT_A_REAL_RESULT"
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert len(excinfo.value.errors) >= 1
+
+
+def test_validate_document_additional_property_raises():
+    from iadf.schemas import validate_document, SchemaValidationError
+    doc = _valid_aoe()
+    doc["unexpected_extra_field"] = "surprise"
