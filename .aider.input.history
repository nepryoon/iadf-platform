+import json
+import re
+import uuid
+from pathlib import Path
+
+import pytest
+
+import iadf
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    SchemaValidationError,
+    load_schema,
+    validate_document,
+)
+
+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
+
+
+def make_digest(seed: str) -> str:
+    import hashlib
+
+    return hashlib.sha256(seed.encode()).hexdigest()
+
+
+def valid_signature():
+    return {"alg": "ed25519", "key_id": "key-1", "value": "abcdef"}
+
+
+def valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": make_digest("subject"),
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": make_digest("policy"),
+        "binding_digest": None,
+        "signature": valid_signature(),
+    }
+
+
+def valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor"],
+        "excluded_paths": [],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.0,
+            "max_tokens_per_call": 1000,
+            "max_wall_seconds": 60,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 30,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2024-06-01T00:00:00Z",
+        "signature": valid_signature(),
+    }
+
+
+def valid_acm():
+    changeset_id = str(uuid.uuid4())
+    return {
+        "manifest_id": str(uuid.uuid4()),
+        "backlog_item_id": str(uuid.uuid4()),
+        "envelope_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": make_digest("scope"),
+        "policy_digest": make_digest("policy"),
+        "budget_digest": make_digest("budget"),
+        "data_class": "INT",
+        "risk_class": "R1",
+        "change_set_plan": [
+            {
+                "changeset_id": changeset_id,
+                "path_globs": ["src/**"],
+                "depends_on": [],
+            }
+        ],
+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "prod-eu",
+        },
+        "environments": ["DEV-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Package basics
+# ---------------------------------------------------------------------------
+
+def test_iadf_version():
+    assert iadf.__version__ == "0.1.0"
+
+
+def test_result_algebra_exact_order():
+    assert tuple(RESULT_ALGEBRA) == EXPECTED_RESULT_ALGEBRA
+    assert len(RESULT_ALGEBRA) == 11
+
+
+def test_schema_dir_is_path_and_exists():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "name,schema_id",
+    [
+        ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+        ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_load_schema_valid_names(name, schema_id):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["$id"] == schema_id
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_schema_files_are_valid_json_on_disk():
+    for filename in (
+        "evidence_receipt.schema.json",
+        "aoe.schema.json",
+        "acm.schema.json",
+    ):
+        path = SCHEMA_DIR / filename
+        assert path.is_file(), f"missing schema file: {path}"
+        data = json.loads(path.read_text())
+        assert data["additionalProperties"] is False
+
+
+# ---------------------------------------------------------------------------
+# EvidenceReceipt schema content assertions
+# ---------------------------------------------------------------------------
+
+def test_evidence_receipt_result_enum_exact():
+    schema = load_schema("evidence_receipt")
+    result_prop = schema["properties"]["result"]
+    assert tuple(result_prop["enum"]) == EXPECTED_RESULT_ALGEBRA
+
+
+def test_evidence_receipt_required_fields():
+    schema = load_schema("evidence_receipt")
+    required = set(schema["required"])
+    expected = {
+        "receipt_id",
+        "schema_id",
+        "subject_digest",
+        "gate_id",
+        "issuer_id",
+        "result",
+        "issued_at",
+        "expires_at",
+        "policy_digest",
+        "binding_digest",
+        "signature",
+    }
+    assert expected.issubset(required)
+
+
+def test_evidence_receipt_schema_id_const():
+    schema = load_schema("evidence_receipt")
+    assert schema["properties"]["schema_id"]["const"] == (
+        "iadf://schema/evidence-receipt/v1"
+    )
+
+
+def test_evidence_receipt_digest_pattern():
+    schema = load_schema("evidence_receipt")
+    pattern = schema["properties"]["subject_digest"]["pattern"]
+    assert pattern == "^[a-f0-9]{64}$"
+
+
+# ---------------------------------------------------------------------------
+# validate_document — EvidenceReceipt
+# ---------------------------------------------------------------------------
+
+def test_validate_evidence_receipt_valid():
+    assert validate_document("evidence_receipt", valid_evidence_receipt()) is None
+
+
+def test_validate_evidence_receipt_invalid_result():
+    doc = valid_evidence_receipt()
+    doc["result"] = "MAYBE"
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    assert len(exc_info.value.errors) >= 1
+    assert any("result" in e for e in exc_info.value.errors)
+
+
+def test_validate_evidence_receipt_bad_digest_pattern():
+    doc = valid_evidence_receipt()
+    doc["subject_digest"] = "not-a-valid-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_additional_property_rejected():
+    doc = valid_evidence_receipt()
+    doc["unexpected_field"] = "oops"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_missing_required():
+    doc = valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_bad_signature():
+    doc = valid_evidence_receipt()
+    doc["signature"] = {"alg": "ed25519", "key_id": "k"}  # missing "value"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+# ---------------------------------------------------------------------------
+# validate_document — AOE
+# ---------------------------------------------------------------------------
+
+def test_validate_aoe_valid():
