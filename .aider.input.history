+
+    envs = props["environments"]
+    assert envs["minItems"] == 1
+    assert envs["uniqueItems"] is True
+    assert envs["items"]["enum"] == [
+        "LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU"
