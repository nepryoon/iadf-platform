+SHA256_HEX = "a" * 64
+
+
+def _uuid():
+    return str(uuid.uuid4())
+
+
+def _now_iso(offset_seconds: int = 0) -> str:
+    return (
+        datetime.now(timezone.utc) + timedelta(seconds=offset_seconds)
+    ).isoformat()
+
+
+def valid_signature():
+    return {"alg": "ed25519", "key_id": "key-1", "value": "sig-value"}
+
+
+def valid_evidence_receipt():
+    return {
+        "receipt_id": _uuid(),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": SHA256_HEX,
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": _now_iso(),
+        "expires_at": None,
+        "policy_digest": SHA256_HEX,
+        "binding_digest": None,
+        "signature": valid_signature(),
+    }
+
+
+def valid_aoe():
+    return {
