+    csp_items = props["change_set_plan"]["items"]
+    assert csp_items["additionalProperties"] is False
+    assert set(csp_items["required"]) == {"changeset_id", "path_globs", "depends_on"}
+
+
+def _valid_acm():
+    return {
+        "manifest_id": UUID1,
+        "backlog_item_id": UUID2,
+        "envelope_id": UUID3,
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": HEX64,
+        "policy_digest": HEX64,
+        "budget_digest": HEX64,
+        "data_class": "INT",
+        "risk_class": "R1",
+        "change_set_plan": [
+            {
+                "changeset_id": UUID4,
+                "path_globs": ["src/**/*.py"],
+                "depends_on": [],
+            }
+        ],
+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "service-x",
+        },
+        "environments": ["DEV-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+def test_acm_valid_document_passes():
+    validate_document("acm", _valid_acm())
+
+
+def test_acm_rejects_bad_status_enum():
+    doc = _valid_acm()
+    doc["status"] = "PENDING"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_acm_rejects_bad_environment_enum():
+    doc = _valid_acm()
+    doc["environments"] = ["MARS-EU"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_acm_rejects_empty_change_set_plan():
+    doc = _valid_acm()
+    doc["change_set_plan"] = []
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_acm_rejects_bad_rollback_type():
+    doc = _valid_acm()
+    doc["rollback_contract"]["type"] = "manual_rollback"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_acm_rejects_additional_properties():
+    doc = _valid_acm()
+    doc["extra_field"] = True
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
