+import json
+import re
+import uuid
+from pathlib import Path
+
+import pytest
+
+# --- Import production modules at their authoritative paths -------------
+import iadf
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    load_schema,
+    validate_document,
+    SchemaValidationError,
+)
+
+
+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
+
+
+def make_sig():
+    return {"alg": "ed25519", "key_id": "k1", "value": "abc123"}
+
+
+def valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": "a" * 64,
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": "b" * 64,
+        "binding_digest": None,
+        "signature": make_sig(),
+    }
+
+
+def valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor"],
+        "excluded_paths": [],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 1000,
+            "max_wall_seconds": 60,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2025-01-01T00:00:00Z",
+        "signature": make_sig(),
+    }
+
+
+def valid_acm():
+    cs_id = str(uuid.uuid4())
+    return {
