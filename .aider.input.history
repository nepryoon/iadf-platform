+
+def test_acm_status_enum_content():
+    schema = load_schema("acm")
+    assert set(schema["properties"]["status"]["enum"]) == {
+        "DRAFT",
+        "ACTIVATED",
+        "REJECTED",
+    }
+
+
+# ---------------------------------------------------------------------------
+# SchemaValidationError shape
+# ---------------------------------------------------------------------------
+
+def test_schema_validation_error_carries_error_list():
+    doc = valid_evidence_receipt()
+    doc["result"] = "INVALID_RESULT"
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert isinstance(excinfo.value.errors, list)
+    assert len(excinfo.value.errors) >= 1
+    assert all(isinstance(e, str) for e in excinfo.value.errors)
