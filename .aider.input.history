+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": SHA256_SAMPLE,
+        "policy_digest": SHA256_SAMPLE,
+        "budget_digest": SHA256_SAMPLE,
+        "data_class": "INT",
+        "risk_class": "R0",
+        "change_set_plan": [
