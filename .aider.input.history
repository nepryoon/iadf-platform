+    doc = _valid_acm()
+    doc["scope_digest"] = "not-a-valid-sha256-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_document_reports_all_violations_not_just_first():
+    from iadf.schemas import validate_document, SchemaValidationError
