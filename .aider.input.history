+"""
+Red-proof tests for TASK-01-SCHEMAS.
+
+These tests MUST fail on the current codebase because
+iadf/schemas/{__init__.py,evidence_receipt.schema.json,aoe.schema.json,
+acm.schema.json} do not exist yet.
+"""
+import json
+import copy
+import uuid
+from pathlib import Path
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Imports of the production package under test.
+# ---------------------------------------------------------------------------
+import iadf  # noqa: F401  (package marker)
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    load_schema,
+    validate_document,
+    SchemaValidationError,
+)
+
+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_SAMPLE = "a" * 64
+SIGNATURE = {"alg": "ed25519", "key_id": "k1", "value": "abc123"}
+
+
+def _valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": SHA256_SAMPLE,
+        "gate_id": "gate.security.sast",
+        "issuer_id": "controller-01",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": SHA256_SAMPLE,
+        "binding_digest": None,
+        "signature": SIGNATURE,
+    }
+
+
+def _valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["refactor", "bugfix"],
+        "excluded_paths": ["/secrets/**"],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 4096,
+            "max_wall_seconds": 600,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2024-06-01T00:00:00Z",
+        "signature": SIGNATURE,
+    }
+
+
+def _valid_acm():
+    return {
+        "manifest_id": str(uuid.uuid4()),
+        "backlog_item_id": str(uuid.uuid4()),
+        "envelope_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "DRAFT",
+        "scope_digest": SHA256_SAMPLE,
+        "policy_digest": SHA256_SAMPLE,
+        "budget_digest": SHA256_SAMPLE,
+        "data_class": "INT",
+        "risk_class": "R0",
+        "change_set_plan": [
+            {
+                "changeset_id": str(uuid.uuid4()),
+                "path_globs": ["src/**/*.py"],
+                "depends_on": [],
+            }
+        ],
+        "rollback_contract": {
+            "type": "redeploy_previous_digest",
+            "target": "prod-eu-cluster",
+        },
+        "environments": ["DEV-EU", "STAGE-EU"],
+        "created_at": "2024-01-01T00:00:00Z",
+        "activated_at": None,
+    }
+
+
+# ---------------------------------------------------------------------------
+# RESULT_ALGEBRA
+# ---------------------------------------------------------------------------
+
+def test_result_algebra_exact_order():
+    assert tuple(RESULT_ALGEBRA) == EXPECTED_RESULT_ALGEBRA
+
+
+def test_schema_dir_is_path_and_exists():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name,schema_id", [
+    ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+    ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+    ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+])
+def test_load_schema_returns_expected_id(name, schema_id):
+    schema = load_schema(name)
+    assert schema["$id"] == schema_id
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_files_are_valid_json_on_disk():
+    for fname in (
+        "evidence_receipt.schema.json",
+        "aoe.schema.json",
+        "acm.schema.json",
+    ):
+        path = SCHEMA_DIR / fname
+        assert path.is_file(), f"missing schema file {fname}"
+        with path.open("r", encoding="utf-8") as fh:
+            json.load(fh)  # must not raise
+
+
+def test_evidence_receipt_result_enum_matches_algebra():
+    schema = load_schema("evidence_receipt")
+    result_prop = schema["properties"]["result"]
+    assert tuple(result_prop["enum"]) == EXPECTED_RESULT_ALGEBRA
+
+
+# ---------------------------------------------------------------------------
+# validate_document — EvidenceReceipt
+# ---------------------------------------------------------------------------
+
+def test_validate_evidence_receipt_valid_document_passes():
+    doc = _valid_evidence_receipt()
+    assert validate_document("evidence_receipt", doc) is None
+
+
+def test_validate_evidence_receipt_missing_required_fails():
+    doc = _valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    errors = exc_info.value.errors
+    assert isinstance(errors, list)
+    assert len(errors) >= 1
+    assert any("gate_id" in e for e in errors)
+
+
+def test_validate_evidence_receipt_invalid_result_value_fails():
+    doc = _valid_evidence_receipt()
+    doc["result"] = "MAYBE"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_bad_digest_pattern_fails():
+    doc = _valid_evidence_receipt()
+    doc["subject_digest"] = "not-a-hex-digest"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_additional_property_fails():
+    doc = _valid_evidence_receipt()
+    doc["unexpected_field"] = "oops"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_bad_uuid_fails():
+    doc = _valid_evidence_receipt()
+    doc["receipt_id"] = "not-a-uuid"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_validate_evidence_receipt_collects_multiple_errors():
+    doc = _valid_evidence_receipt()
+    del doc["gate_id"]
+    doc["result"] = "NONSENSE"
+    with pytest.raises(SchemaValidationError) as exc_info:
+        validate_document("evidence_receipt", doc)
+    assert len(exc_info.value.errors) >= 2
+
+
+# ---------------------------------------------------------------------------
+# validate_document — AOE
+# ---------------------------------------------------------------------------
+
+def test_validate_aoe_valid_document_passes():
+    doc = _valid_aoe()
+    assert validate_document("aoe", doc) is None
+
+
+def test_validate_aoe_wrong_data_residency_fails():
+    doc = _valid_aoe()
+    doc["data_residency"] = "us-east"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_aoe_negative_budget_fails():
+    doc = _valid_aoe()
+    doc["budgets"]["max_cost_eur"] = -5
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_aoe_retention_days_too_high_fails():
+    doc = _valid_aoe()
+    doc["retention_days"] = 5000
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_aoe_invalid_risk_ceiling_fails():
+    doc = _valid_aoe()
+    doc["risk_ceiling"] = "R9"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_aoe_duplicate_allowed_change_classes_fails():
+    doc = _valid_aoe()
+    doc["allowed_change_classes"] = ["refactor", "refactor"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_validate_aoe_missing_signature_fails():
+    doc = _valid_aoe()
+    del doc["signature"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+# ---------------------------------------------------------------------------
+# validate_document — ACM
+# ---------------------------------------------------------------------------
+
+def test_validate_acm_valid_document_passes():
+    doc = _valid_acm()
+    assert validate_document("acm", doc) is None
+
+
+def test_validate_acm_invalid_status_fails():
+    doc = _valid_acm()
+    doc["status"] = "PENDING"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_invalid_data_class_fails():
+    doc = _valid_acm()
+    doc["data_class"] = "TOPSECRET"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_empty_change_set_plan_fails():
+    doc = _valid_acm()
+    doc["change_set_plan"] = []
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_invalid_rollback_type_fails():
+    doc = _valid_acm()
+    doc["rollback_contract"]["type"] = "unknown_strategy"
+    with pytest.raises(SchemaValidationError):
