+"""
+Red-proof tests for TASK-01-SCHEMAS.
+
+These tests import the production package `iadf` and `iadf.schemas`
+and validate the JSON Schema documents plus the loader/validator API.
+Hermetic: no network, no external services, reads only files shipped
+in the repository under iadf/schemas/.
+"""
+import json
+import re
+import uuid
+from pathlib import Path
+
+import pytest
+
+iadf = pytest.importorskip("iadf")
+iadf_schemas = pytest.importorskip("iadf.schemas")
+
+from iadf.schemas import (
+    RESULT_ALGEBRA,
+    SCHEMA_DIR,
+    load_schema,
+    validate_document,
+    SchemaValidationError,
+)
+
+EXPECTED_RESULT_ALGEBRA = (
+    "PASS",
+    "FAIL",
+    "NOT_RUN",
+    "SKIPPED",
+    "UNKNOWN",
+    "ERROR",
+    "INCONCLUSIVE",
+    "TIMEOUT",
+    "STALE",
+    "EXPIRED",
+    "SUPERSEDED",
+)
+
+SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
+
+
+def make_digest(seed: str) -> str:
+    import hashlib
+
+    return hashlib.sha256(seed.encode()).hexdigest()
+
+
+def make_signature():
+    return {"alg": "ed25519", "key_id": "key-1", "value": "abcdef"}
+
+
+# ---------------------------------------------------------------------------
+# Package-level
+# ---------------------------------------------------------------------------
+
+def test_iadf_version():
+    assert iadf.__version__ == "0.1.0"
+
+
+def test_result_algebra_exact_order_and_values():
+    assert tuple(RESULT_ALGEBRA) == EXPECTED_RESULT_ALGEBRA
+
+
+def test_schema_dir_exists_and_is_path():
+    assert isinstance(SCHEMA_DIR, Path)
+    assert SCHEMA_DIR.is_dir()
+
+
+# ---------------------------------------------------------------------------
+# load_schema
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "name,expected_id",
+    [
+        ("evidence_receipt", "iadf://schema/evidence-receipt/v1"),
+        ("aoe", "iadf://schema/autonomous-operating-envelope/v1"),
+        ("acm", "iadf://schema/autonomous-change-manifest/v1"),
+    ],
+)
+def test_load_schema_valid_names(name, expected_id):
+    schema = load_schema(name)
+    assert isinstance(schema, dict)
+    assert schema["$id"] == expected_id
+    assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
+    assert schema["type"] == "object"
+    assert schema["additionalProperties"] is False
+
+
+def test_load_schema_unknown_name_raises_keyerror():
+    with pytest.raises(KeyError):
+        load_schema("does_not_exist")
+
+
+def test_load_schema_files_are_valid_json_on_disk():
+    for fname in (
+        "evidence_receipt.schema.json",
+        "aoe.schema.json",
+        "acm.schema.json",
+    ):
+        path = SCHEMA_DIR / fname
+        assert path.is_file(), f"missing schema file {fname}"
+        data = json.loads(path.read_text())
+        assert "$id" in data
+
+
+# ---------------------------------------------------------------------------
+# EvidenceReceipt schema content + validation
+# ---------------------------------------------------------------------------
+
+def test_evidence_receipt_result_enum_exact():
+    schema = load_schema("evidence_receipt")
+    result_prop = schema["properties"]["result"]
+    assert tuple(result_prop["enum"]) == EXPECTED_RESULT_ALGEBRA
+
+
+def valid_evidence_receipt():
+    return {
+        "receipt_id": str(uuid.uuid4()),
+        "schema_id": "iadf://schema/evidence-receipt/v1",
+        "subject_digest": make_digest("subject"),
+        "gate_id": "gate-1",
+        "issuer_id": "issuer-1",
+        "result": "PASS",
+        "issued_at": "2024-01-01T00:00:00Z",
+        "expires_at": None,
+        "policy_digest": make_digest("policy"),
+        "binding_digest": None,
+        "signature": make_signature(),
+    }
+
+
+def test_evidence_receipt_valid_document_passes():
+    doc = valid_evidence_receipt()
+    validate_document("evidence_receipt", doc)  # must not raise
+
+
+def test_evidence_receipt_rejects_additional_properties():
+    doc = valid_evidence_receipt()
+    doc["unexpected_field"] = "nope"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_rejects_bad_digest_pattern():
+    doc = valid_evidence_receipt()
+    doc["subject_digest"] = "NOT-A-VALID-HEX-DIGEST"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_rejects_invalid_result_value():
+    doc = valid_evidence_receipt()
+    doc["result"] = "MAYBE"
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_accepts_null_binding_digest_and_expiry():
+    doc = valid_evidence_receipt()
+    doc["binding_digest"] = None
+    doc["expires_at"] = None
+    validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_missing_required_field_fails():
+    doc = valid_evidence_receipt()
+    del doc["gate_id"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("evidence_receipt", doc)
+
+
+def test_evidence_receipt_multiple_violations_all_reported():
+    doc = valid_evidence_receipt()
+    doc["subject_digest"] = "bad"
+    doc["result"] = "NOPE"
+    doc["extra"] = "field"
+    with pytest.raises(SchemaValidationError) as excinfo:
+        validate_document("evidence_receipt", doc)
+    assert len(excinfo.value.errors) >= 3
+
+
+# ---------------------------------------------------------------------------
+# AOE schema content + validation
+# ---------------------------------------------------------------------------
+
+def valid_aoe():
+    return {
+        "envelope_id": str(uuid.uuid4()),
+        "project_id": str(uuid.uuid4()),
+        "version": 1,
+        "status": "ACTIVE",
+        "allowed_change_classes": ["docs", "code"],
+        "excluded_paths": ["secrets/**"],
+        "risk_ceiling": "R1",
+        "budgets": {
+            "max_cost_eur": 10.5,
+            "max_tokens_per_call": 4096,
+            "max_wall_seconds": 600,
+        },
+        "data_residency": "eu-only",
+        "retention_days": 365,
+        "effective_from": "2024-01-01T00:00:00Z",
+        "effective_to": "2025-01-01T00:00:00Z",
+        "signature": make_signature(),
+    }
+
+
+def test_aoe_valid_document_passes():
+    validate_document("aoe", valid_aoe())
+
+
+def test_aoe_rejects_additional_properties():
+    doc = valid_aoe()
+    doc["extra"] = 1
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_rejects_wrong_data_residency():
+    doc = valid_aoe()
+    doc["data_residency"] = "us-only"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_rejects_retention_days_over_max():
+    doc = valid_aoe()
+    doc["retention_days"] = 2556
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_rejects_non_positive_budget():
+    doc = valid_aoe()
+    doc["budgets"]["max_cost_eur"] = 0
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_rejects_invalid_risk_ceiling():
+    doc = valid_aoe()
+    doc["risk_ceiling"] = "R9"
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_rejects_duplicate_allowed_change_classes():
+    doc = valid_aoe()
+    doc["allowed_change_classes"] = ["docs", "docs"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("aoe", doc)
+
+
+def test_aoe_schema_status_enum_content():
+    schema = load_schema("aoe")
+    assert set(schema["properties"]["status"]["enum"]) == {
+        "DRAFT",
+        "ACTIVE",
+        "EXPIRED",
+        "SUPERSEDED",
+    }
+
+
+# ---------------------------------------------------------------------------
+# ACM schema content + validation
+# ---------------------------------------------------------------------------
+
+def valid_acm():
+    changeset_id = str(uuid.uuid4())
+    return {
+        "manifest_id": str(uuid.uuid4()),
+        "backlog_item_id": str(uuid.uuid4()),
