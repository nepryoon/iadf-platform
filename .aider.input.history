+
+
+def test_validate_acm_invalid_environment_fails():
+    doc = _valid_acm()
+    doc["environments"] = ["MOON-BASE"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_duplicate_environments_fails():
+    doc = _valid_acm()
+    doc["environments"] = ["DEV-EU", "DEV-EU"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_bad_digest_pattern_fails():
+    doc = _valid_acm()
+    doc["scope_digest"] = "short"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_changeset_missing_path_globs_fails():
+    doc = _valid_acm()
+    del doc["change_set_plan"][0]["path_globs"]
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+def test_validate_acm_additional_property_fails():
+    doc = _valid_acm()
+    doc["extra_unknown"] = True
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+
+
+# ---------------------------------------------------------------------------
+# Cache non-mutation guarantee
+# ---------------------------------------------------------------------------
+
+def test_load_schema_cached_document_not_mutated_by_validation():
+    original = copy.deepcopy(load_schema("acm"))
+    doc = _valid_acm()
+    doc["status"] = "BOGUS"
+    with pytest.raises(SchemaValidationError):
+        validate_document("acm", doc)
+    after = load_schema("acm")
+    assert after == original
