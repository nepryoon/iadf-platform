+    assert props["risk_class"]["enum"] == ["R0", "R1", "R2", "R3"]
+
+    csp = props["change_set_plan"]
+    assert csp["minItems"] == 1
+    item_schema = csp["items"]
+    assert item_schema["additionalProperties"] is False
+    assert set(item_schema["required"]) == {
+        "changeset_id", "path_globs", "depends_on"
+    }
+
+    rollback = props["rollback_contract"]
+    assert rollback["additionalProperties"] is False
+    assert set(rollback["required"]) == {"type", "target"}
+    assert rollback["properties"]["type"]["enum"] == [
+        "redeploy_previous_digest", "expand_contract_migration"
