{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iadf://schema/autonomous-operating-envelope/v1",
  "title": "AutonomousOperatingEnvelope",
  "description": "Envelope operativo che delimita l'autonomia concessa a un progetto IADF (ADD 4, 19).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "project_id",
    "version",
    "status",
    "allowed_change_classes",
    "excluded_paths",
    "risk_ceiling",
    "budgets",
    "data_residency",
    "retention_days",
    "effective_from",
    "effective_to",
    "signature"
  ],
  "properties": {
    "envelope_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"]
    },
    "allowed_change_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "refactor",
          "feature",
          "bugfix",
          "chore",
          "migration",
          "config"
        ]
      }
    },
    "excluded_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_ceiling": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost_eur",
        "max_tokens_per_call",
        "max_wall_seconds"
      ],
      "properties": {
        "max_cost_eur": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_tokens_per_call": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "max_wall_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "data_residency": {
      "type": "string",
      "enum": ["eu-only", "eu-preferred"]
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2555
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["ed25519"]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
