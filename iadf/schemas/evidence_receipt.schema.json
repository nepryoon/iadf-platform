{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iadf://schema/evidence-receipt/v1",
  "title": "EvidenceReceipt",
  "description": "Ricevuta di evidenza emessa da un gate di verifica IADF (ADD 20.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema_id",
    "subject_digest",
    "gate_id",
    "issuer_id",
    "result",
    "issued_at",
    "expires_at",
    "policy_digest",
    "binding_digest",
    "signature"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_id": {
      "const": "iadf://schema/evidence-receipt/v1"
    },
    "subject_digest": {
      "$ref": "#/$defs/sha256"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "SKIPPED",
        "UNKNOWN",
        "ERROR",
        "INCONCLUSIVE",
        "TIMEOUT",
        "STALE",
        "EXPIRED",
        "SUPERSEDED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "binding_digest": {
      "$ref": "#/$defs/sha256_nullable"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256_nullable": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["ed25519"]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
