{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iadf://schema/autonomous-change-manifest/v1",
  "title": "AutonomousChangeManifest",
  "description": "Manifesto di cambiamento autonomo vincolato a un AOE (ADD 4, 25.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "backlog_item_id",
    "envelope_id",
    "version",
    "status",
    "scope_digest",
    "policy_digest",
    "budget_digest",
    "data_class",
    "risk_class",
    "change_set_plan",
    "rollback_contract",
    "environments",
    "created_at",
    "activated_at"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "backlog_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "envelope_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVATED", "REJECTED"]
    },
    "scope_digest": {
      "$ref": "#/$defs/sha256"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "budget_digest": {
      "$ref": "#/$defs/sha256"
    },
    "data_class": {
      "type": "string",
      "enum": ["PUB", "INT", "CONF", "SRC", "SEC"]
    },
    "risk_class": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3"]
    },
    "change_set_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeset_id", "path_globs", "depends_on"],
        "properties": {
          "changeset_id": {
            "type": "string",
            "format": "uuid"
          },
          "path_globs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "rollback_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "redeploy_previous_digest",
            "expand_contract_migration"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU"]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
