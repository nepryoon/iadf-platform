{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "iadf://schema/autonomous-change-manifest/v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "manifest_id",
        "backlog_item_id",
        "envelope_id",
        "version",
        "status",
        "scope_digest",
        "policy_digest",
        "budget_digest",
        "data_class",
        "risk_class",
        "change_set_plan",
        "rollback_contract",
        "environments",
        "created_at",
        "activated_at"
    ],
    "properties": {
        "manifest_id": {
            "type": "string",
            "format": "uuid"
        },
        "backlog_item_id": {
            "type": "string",
            "format": "uuid"
        },
        "envelope_id": {
            "type": "string",
            "format": "uuid"
        },
        "version": {
            "type": "integer",
            "minimum": 1
        },
        "status": {
            "enum": ["DRAFT", "ACTIVATED", "REJECTED"]
        },
        "scope_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "budget_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "data_class": {
            "enum": ["PUB", "INT", "CONF", "SRC", "SEC"]
        },
        "risk_class": {
            "enum": ["R0", "R1", "R2", "R3"]
        },
        "change_set_plan": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "changeset_id",
                    "path_globs",
                    "depends_on"
                ],
                "properties": {
                    "changeset_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "path_globs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "minItems": 1
                    },
                    "depends_on": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                }
            }
        },
        "rollback_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target"],
            "properties": {
                "type": {
                    "enum": [
                        "redeploy_previous_digest",
                        "expand_contract_migration"
                    ]
                },
                "target": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "environments": {
            "type": "array",
            "items": {
                "enum": ["LOCAL-SYNTH", "DEV-EU", "STAGE-EU", "PROD-EU"]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "activated_at": {
            "type": ["string", "null"],
            "format": "date-time"
        }
    }
}
